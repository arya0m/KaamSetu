# Copy to .env and fill in. Never commit .env.
# Hostnames below (postgres, redis) are Docker Compose service names.
# For running the API on the host instead, use localhost.

# --- App ---------------------------------------------------------------
# development | test | production. In production the API refuses to start
# if any URL still contains "change-me" or DASHBOARD_ORIGIN is not https://.
APP_ENV=development
LOG_LEVEL=INFO
# Only this origin may call the API from a browser (CORS).
DASHBOARD_ORIGIN=http://localhost:3000

# --- PostgreSQL 16 + pgvector (used by the postgres container) ----------
POSTGRES_USER=kaamsetu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kaamsetu
# Must use the same credentials as above.
DATABASE_URL=postgresql+psycopg://kaamsetu:change-me@postgres:5432/kaamsetu
DB_CONNECT_TIMEOUT_S=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis / Celery ------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Optional; defaults to REDIS_URL.
CELERY_BROKER_URL=

# --- AI pipeline -----------------------------------------------------------
# Must match the embedding model's output size. Read by the initial migration,
# so change it before the first `alembic upgrade head`.
EMBEDDING_DIM=768

# --- Matching (weights must sum to 1.0) ------------------------------------
MATCH_WEIGHT_SKILL=0.6
MATCH_WEIGHT_DISTANCE=0.25
MATCH_WEIGHT_EXPERIENCE=0.15
MATCH_THRESHOLD=0.55
MATCH_MAX_DISTANCE_KM=25

# --- Health checks ---------------------------------------------------------
READINESS_TIMEOUT_S=2

# --- HTTP server (uvicorn) ------------------------------------------------
# Proxies whose X-Forwarded-For/-Proto headers are trusted. Set to your load
# balancer's address range in production; never "*" on a public listener.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- WhatsApp via Twilio ---------------------------------------------------
# Console: https://console.twilio.com -> Messaging -> Try it out -> WhatsApp sandbox.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
# Also used to verify X-Twilio-Signature on every webhook; empty rejects all webhooks.
TWILIO_AUTH_TOKEN=change-me
# The sandbox number is whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_API_BASE_URL=https://api.twilio.com
# The exact public HTTPS URL Twilio calls (e.g. your tunnel). Signatures are
# computed over it, so it must match the sandbox's webhook URL setting.
PUBLIC_BASE_URL=http://localhost:8000
# The Twilio sandbox accepts one message per 3 seconds; 0 disables throttling.
WHATSAPP_MIN_SEND_INTERVAL_MS=3000
WHATSAPP_SEND_TIMEOUT_S=10

# --- Onboarding and consent (FR-1) -----------------------------------------
# Linked in the welcome message (PRD: Privacy).
PRIVACY_NOTICE_URL=http://localhost:3000/privacy
# Pre-consent state lives only in Redis and expires after this many seconds.
PRECONSENT_TTL_S=86400
# How long a provider message ID is remembered to drop duplicate deliveries.
IDEMPOTENCY_TTL_S=604800

# --- Phone numbers -----------------------------------------------------------
# Secret salt for the phone lookup hash. Generate: python3 -c 'import secrets;print(secrets.token_hex(32))'
# Never change it after workers exist: their hashes would no longer match.
PHONE_HASH_SALT=change-me
# "none" stores phone numbers unencrypted until Phase 7; production refuses to start with it.
PHONE_ENCRYPTION=none
